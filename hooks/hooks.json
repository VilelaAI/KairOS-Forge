{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🔥 kairos-forge v0.30 ativo — 71 agentes (40 core + 31 apoio em 10 squads) | 18 skills: /kairos-forge:onboardar mapear-arquitetura diagnosticar especificar analisar-ameacas desenhar mobilizar rodar validar revisar entregar avaliar lancar mapear-conhecimento otimizar migrar auditar evoluir | Para mobilizar paralelo: export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1'"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/execucao.py\" inicio 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/execucao.py\" prompt 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guardrail.py\" comando"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guardrail.py\" escrita"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/execucao.py\" ferramenta 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/execucao.py\" alerta 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guardrail.py\" spec"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guardrail.py\" contrato"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "IN=$(cat); FILE=$(printf '%s' \"$IN\" | jq -r '.tool_input.file_path // empty'); SID=$(printf '%s' \"$IN\" | jq -r '.session_id // \"sem-sessao\"'); MARCA=\"${TMPDIR:-/tmp}/kairos-forge-lembrete-$SID\"; if [ ! -e \"$MARCA\" ] && printf '%s' \"$FILE\" | grep -qE '\\.(py|ts|tsx|js|jsx|go|rs|java)$' && ! printf '%s' \"$FILE\" | grep -qE '(test|spec|__tests__)'; then touch \"$MARCA\"; echo '💡 kairos-forge: primeiro arquivo de produção desta sessão. A Definition of Done cobre teste (Ricardo), /kairos-forge:validar se houver SPEC e /kairos-forge:revisar antes do PR — este aviso não se repete na sessão.'; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/execucao.py\" fim 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
